{
  "name": "cash-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Cash-only bookkeeping PWA that syncs to the user's own Google Sheet",
  "scripts": {
    "start": "node tools/serve.cjs",
    "test": "node --test tests/*.test.mjs",
    "build:pwa": "node tools/build-sw.cjs",
    "format": "npx --yes prettier@3.9.10 --write .",
    "format:check": "npx --yes prettier@3.9.10 --check ."
  },
  "engines": {
    "node": ">=22"
  },
